{
  "name": "taller-canamo",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.20.0 || ^24.12.0 || >=25.0.0"
  },
  "scripts": {
    "lint": "eslint frontend e2e public scripts *.ts eslint.config.mjs --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npm run build && .venv/bin/python scripts/run_preview.py --data \"${XDG_DATA_HOME:-$HOME/.local/share}/taller-canamo-preview/data\"",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "build": "npm run typecheck && vite build",
    "test:e2e": "playwright test",
    "preview": "python scripts/run_preview.py",
    "test": "python -m pytest",
    "tauri": "tauri",
    "desktop:build": "python scripts/build_desktop.py"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "26.6.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.8",
    "typescript": "5.9.2",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7"
  }
}
