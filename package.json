{
  "name": "taller-canamo",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.20.0 || ^24.12.0 || >=25.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "build": "npm run typecheck && vite build",
    "test:e2e": "playwright test",
    "preview": "python scripts/run_preview.py",
    "test": "python -m pytest",
    "tauri": "tauri",
    "desktop:build": "python scripts/build_desktop.py"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "26.6.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "prettier": "3.9.8",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
